generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model User {
    id Int @id @default(autoincrement())
    name String
    email String @unique
    password_hash String
    expenses Expense[]
}

model Expense {
    id Int @id @default(autoincrement())
    name String
    amount Float 
    date DateTime
    user User @relation(fields: [userId] ,references: [id])
    userId Int 
    category Category @relation(fields: [categoryId] ,references: [id])
    categoryId Int
}

model Category {
    id Int @id @default(autoincrement())
    name String
    expenses Expense[]
}